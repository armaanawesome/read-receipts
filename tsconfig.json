{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // boundary.test.ts walks the filesystem to enforce the engine/content
    // purity rule, so the Node built-ins need to be in scope for tsc.
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@content/*": ["./content/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // supabase/functions runs on Deno, not React Native: it imports over https
  // and uses the Deno global, neither of which this tsconfig can resolve. It is
  // typechecked by the Supabase CLI at deploy time instead.
  "exclude": ["node_modules", "supabase/functions"]
}
